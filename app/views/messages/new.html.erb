<div class="flex items-center justify-center h-screen md:h-full">
  <div class="flex flex-col gap-4 w-96">
    <h1 class="text-xxl text-gray-600">Get in touch</h1>
    <% if alert %>
      <%= render partial: 'shared/form_errors', alert: alert %>
    <% end %>
    <%= form_for @message, html: { class: 'w-full flex flex-col items-start gap-8' } do |form| %>
      <%= form.invisible_captcha :subtitle %>
      <div class="flex flex-col w-full">
        <%= form.label :name %>
        <%= form.text_field :name, class: 'rounded', placeholder: 'Enter your name' %>
      </div>
      <div class="flex flex-col w-full">
        <%= form.label :email %>
        <%= form.email_field :email, class: 'rounded', placeholder: 'Best email to reach you' %>
      </div>
      <div class="flex flex-col w-full">
        <%= form.label :message %>
        <%= form.text_area :message, class: 'rounded', placeholder: 'Brief message' %>
      </div>
      <%= form.submit 'Send Message', class: 'form-button', data: { disable: { with: 'Submitting...' } } %>
    <% end %>
  <div>
</div>