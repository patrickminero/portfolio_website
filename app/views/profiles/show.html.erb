<div class="w-full h-full">
  <div class="h-full w-full" data-controller="tabs" data-tabs-active-tab="opacity-100 transform transition-all duration-500" data-tabs-inactive-tab="opacity-50 transform transition-all duration-500">
    <ul class="list-reset flex border-b border-black justify-end">
      <div class="w-full flex items-center justify-between">
        <div class="opacity-100" data-action="click->tabs#change">
          <h1 class="text-xl font-semibold pl-4"><%= @profile.name %></h1>
        </div>
        <div class="flex items-center gap-2 divide-x-2 divide-black">
          <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change">
            <p class="bg-white inline-block py-2 px-4 text-blue-500 hover:text-blue-700 font-semibold no-underline">Resume</p>
          </li>
          <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change">
            <p class="bg-white inline-block py-2 px-4 text-blue-500 hover:text-blue-700 font-semibold no-underline">Projects</p>
          </li>
          <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change">
            <p class="bg-white inline-block py-2 px-4 text-blue-500 hover:text-blue-700 font-semibold no-underline">Contact</p>
          </li>
        </div>
      </div>
    </ul>
    <div class="flex justify-center w-full h-full">
      <div class="hidden w-4/5 h-full flex items-center justify-center" data-tabs-target="panel">
        <%= render partial: 'home_tab' %>
      </div>

      <div class="hidden w-4/5 h-full flex items-center justify-center" data-tabs-target="panel">
        Resume
      </div>

      <div class="hidden w-4/5 h-full flex items-center justify-center" data-tabs-target="panel">
        Projects
      </div>

      <div class="hidden w-4/5 h-full flex items-center justify-center" data-tabs-target="panel">
        Contact
      </div>
    </div>
  </div>
</div>